# Tests the wheel wheelhouse/aymara-<version>-<wheel>-<manylinux>_x86_64.whl of
# the build context: the CI downloads there the wheel artifact of its own run
# (the one published to PyPI), not an image shared by concurrent runs.
# TEST_PYTHON_VERSION: the Python it is tested with (the abi3 wheel works with
# all the Pythons shiboken6 supports)
ARG TEST_PYTHON_VERSION=3.9
FROM python:${TEST_PYTHON_VERSION}

ARG LIMA_PYTHON_VERSION
ARG PYTHON_WHEEL_VERSION
# The wheel's manylinux base (its file name)
ARG MANYLINUX=manylinux_2_28

# The models release to test with (a tag of the aymaralima/deeplima Hugging
# Face repository; default: the one aymara.lima_models names)
ARG LIMA_MODELS_REVISION
ENV LIMA_MODELS_REVISION=${LIMA_MODELS_REVISION}

RUN pip install -U pip
RUN pip install pytest pytest-cov pytest-runner pytest-depends

COPY wheelhouse/aymara-${LIMA_PYTHON_VERSION}-${PYTHON_WHEEL_VERSION}-${MANYLINUX}_x86_64.whl /
RUN pip install /aymara-${LIMA_PYTHON_VERSION}-${PYTHON_WHEEL_VERSION}-${MANYLINUX}_x86_64.whl
# Optional (aymara[spacy]): the spaCy tests are skipped where spaCy has no wheel
RUN pip install --only-binary=:all: "spacy>=3.7,<4" || echo "spaCy not available: its tests are skipped"
RUN install -d /lima-python
# test_aymara.py analyzes with this model (named by its udlang)
RUN lima_models -i eng-UD_English-EWT
# and with the French default model (the deprecated "fre" is ud-fra, whose
# deepud pipeline runs the French named entities rules)
RUN lima_models -i fra

WORKDIR /lima-python
COPY .coveragerc .
RUN install -d /lima-python/tests
COPY tests/* /lima-python/tests/
COPY aymara/* /lima-python/aymara/
RUN python3 -m pytest --cov=aymara --cov-config=.coveragerc --cov-report term-missing  tests/
