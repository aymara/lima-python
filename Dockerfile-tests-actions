# PYTHON_VERSION: the Python the wheel was built with (the lima-python image);
# TEST_PYTHON_VERSION: the one it is tested with (the abi3 wheel works with
# all the Pythons shiboken6 supports)
ARG PYTHON_VERSION=3.9
ARG TEST_PYTHON_VERSION=${PYTHON_VERSION}
FROM aymara/lima-python${PYTHON_VERSION}:latest AS lima_python

ARG TEST_PYTHON_VERSION
FROM python:${TEST_PYTHON_VERSION}

ARG LIMA_PYTHON_VERSION
ARG PYTHON_WHEEL_VERSION

# The models release to test with (a tag of the aymaralima/deeplima Hugging
# Face repository; default: the one aymara.lima_models names)
ARG LIMA_MODELS_REVISION
ENV LIMA_MODELS_REVISION=${LIMA_MODELS_REVISION}

RUN pip install -U pip
RUN pip install pytest pytest-cov pytest-runner pytest-depends

COPY --from=lima_python /lima-python/wheelhouse/aymara-${LIMA_PYTHON_VERSION}-${PYTHON_WHEEL_VERSION}-manylinux_2_28_x86_64.whl /
RUN pip install /aymara-${LIMA_PYTHON_VERSION}-${PYTHON_WHEEL_VERSION}-manylinux_2_28_x86_64.whl
RUN install -d /lima-python
# test_aymara.py analyzes with this model (named by its udlang)
RUN lima_models -i eng-UD_English-EWT

WORKDIR /lima-python
COPY .coveragerc .
RUN install -d /lima-python/tests
COPY tests/* /lima-python/tests/
COPY aymara/* /lima-python/aymara/
RUN python3 -m pytest --cov=aymara --cov-config=.coveragerc --cov-report term-missing  tests/
